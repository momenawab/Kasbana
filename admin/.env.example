# Copy to .env for local dev. In CI the value is baked at build time.
# API base — the admin console calls /api/admin/v1 under this origin.
VITE_API_URL=http://localhost:8000

# Merchant dashboard origin — the "view as merchant" (impersonation) button
# opens it with the session token in the URL fragment. Defaults to
# https://app.stampn.net; point at http://localhost:5174 for local dev.
VITE_DASHBOARD_URL=http://localhost:5174
