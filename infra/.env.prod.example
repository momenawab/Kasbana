# Copy to infra/.env ON THE SERVER (never commit the real file). Holds every
# secret the prod stack needs. compose loads it for ${...} interpolation and
# passes it to the web/worker/beat containers.

# ── Image ─────────────────────────────────────────────────────────────────────
# Set by the deploy script per release; leave as latest for manual runs.
IMAGE_TAG=latest

# ── Caddy / HTTPS ─────────────────────────────────────────────────────────────
# Site hostnames are configured directly in caddy/Caddyfile. Caddy issues Let's
# Encrypt certs automatically once the A record resolves to this box. DOMAIN is
# no longer used by the Caddyfile.
#
# NOTE: only api.stampn.net points at this server. admin.stampn.net is a static
# SPA on Hostinger that calls this API from the browser — the admin block in the
# Caddyfile is dead config. Keep admin.stampn.net in ALLOWED_HOSTS/CSRF/CORS
# below: that is the SPA's browser origin, not a site this box serves.

# Flip to true once the domains resolve here and have certs (required for Apple
# Wallet). Keep false only for plain-HTTP bring-up over the bare IP.
HTTPS_ENABLED=true

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
DEBUG=false
ALLOWED_HOSTS=api.stampn.net,13.49.70.197,localhost
BASE_URL=https://api.stampn.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.stampn.net,https://app.stampn.net,https://admin.stampn.net
# Must include the admin console origin or its login POST fails CORS ("network error").
CORS_ALLOWED_ORIGINS=https://stampn.net,https://app.stampn.net,https://admin.stampn.net

# ── Observability (Sentry) ────────────────────────────────────────────────────
# Paste the DSN from your Sentry project (Settings → Client Keys). Blank = off.
# SENTRY_RELEASE is injected automatically by compose (= deployed image tag).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_PII=false

# ── Postgres (container) ──────────────────────────────────────────────────────
# Live prod uses stampn/stampn — these were kasbana/kasbana before the rebrand
# (a6a0c7c). On an EXISTING server trust the real .env, not this template.
POSTGRES_DB=stampn
POSTGRES_USER=stampn
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://stampn:CHANGE_ME_STRONG_PASSWORD@db:5432/stampn

# ── Redis (container) ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Apple / Google Wallet (Phase 1.1) ─────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.app.kasbana.loyalty
APPLE_PASS_CERT_PATH=/secrets/pass.p12
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=/secrets/wwdr.pem
APNS_USE_SANDBOX=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SA_KEY_PATH=/secrets/google-sa.json
# Optional: default program logo for Google Wallet classes (must be public
# HTTPS). Defaults to <BASE_URL>/static/wallet/logo.png if unset.
WALLET_DEFAULT_LOGO_URL=

# ── Billing (Phase 1.4) ───────────────────────────────────────────────────────
# Unset PAYMOB_API_KEY → the adapter runs in stub mode (no live charges).
# HMAC_SECRET verifies inbound webhooks — a mismatch fails them SILENTLY, so
# rotate it here and in the Paymob dashboard in the same window. See
# main/docs/Secret-Rotation-Runbook.md.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# ── WhatsApp Cloud API — phone verification / OTP ─────────────────────────────
# All empty → the feature stays installed but inert: send/verify raise a clean
# provider error and the webhook rejects every call. Fill from Meta:
#   ACCESS_TOKEN       business.facebook.com → Business Settings → System Users
#                      → Generate New Token (expiration: Never) with scopes
#                      whatsapp_business_messaging + whatsapp_business_management
#   PHONE_NUMBER_ID    developers.facebook.com → WhatsApp → API Setup
#   BUSINESS_ACCOUNT_ID  same page (the WABA id)
#   APP_SECRET         App Settings → Basic → App secret (signs webhooks)
#   VERIFY_TOKEN       self-chosen (openssl rand -hex 24); paste the SAME string
#                      into WhatsApp → Configuration → Webhook. Must be set here
#                      BEFORE clicking "Verify and save" or Meta gets a 403.
# The send path expects an approved Authentication template named exactly
# `stampn_login`, language `en`, one body parameter (whatsapp/services.py).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# ── Backups ───────────────────────────────────────────────────────────────────
# Off-box destination for nightly DB dumps (scripts/backup.sh). Strongly
# recommended — a backup only on this server is lost if the server is.
# Requires the AWS CLI configured on the box with s3:PutObject on the bucket.
BACKUP_S3=
