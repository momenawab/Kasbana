# Copy to infra/.env ON THE SERVER (never commit the real file). Holds every
# secret the prod stack needs. compose loads it for ${...} interpolation and
# passes it to the web/worker/beat containers.

# ── Image ─────────────────────────────────────────────────────────────────────
# Set by the deploy script per release; leave as latest for manual runs.
IMAGE_TAG=latest

# ── Caddy / HTTPS ─────────────────────────────────────────────────────────────
# Site hostnames are configured directly in caddy/Caddyfile (api.kasbana.net,
# admin.kasbana.net). Caddy issues Let's Encrypt certs automatically once those
# A records resolve to this box. DOMAIN is no longer used by the Caddyfile.

# Flip to true once the domains resolve here and have certs (required for Apple
# Wallet). Keep false only for plain-HTTP bring-up over the bare IP.
HTTPS_ENABLED=true

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
DEBUG=false
ALLOWED_HOSTS=api.stampn.net,13.49.70.197,localhost
BASE_URL=https://api.stampn.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.stampn.net,https://app.stampn.net,https://admin.stampn.net
# Must include the admin console origin or its login POST fails CORS ("network error").
CORS_ALLOWED_ORIGINS=https://stampn.net,https://app.stampn.net,https://admin.stampn.net

# ── Observability (Sentry) ────────────────────────────────────────────────────
# Paste the DSN from your Sentry project (Settings → Client Keys). Blank = off.
# SENTRY_RELEASE is injected automatically by compose (= deployed image tag).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_PII=false

# ── Postgres (container) ──────────────────────────────────────────────────────
POSTGRES_DB=kasbana
POSTGRES_USER=kasbana
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://kasbana:CHANGE_ME_STRONG_PASSWORD@db:5432/kasbana

# ── Redis (container) ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Apple / Google Wallet (Phase 1.1) ─────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.app.kasbana.loyalty
APPLE_PASS_CERT_PATH=/secrets/pass.p12
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=/secrets/wwdr.pem
APNS_USE_SANDBOX=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SA_KEY_PATH=/secrets/google-sa.json
# Optional: default program logo for Google Wallet classes (must be public
# HTTPS). Defaults to <BASE_URL>/static/wallet/logo.png if unset.
WALLET_DEFAULT_LOGO_URL=

# ── Billing (Phase 1.4) ───────────────────────────────────────────────────────
# Unset PAYMOB_API_KEY → the adapter runs in stub mode (no live charges).
# HMAC_SECRET verifies inbound webhooks — a mismatch fails them SILENTLY, so
# rotate it here and in the Paymob dashboard in the same window. See
# main/docs/Secret-Rotation-Runbook.md.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# ── Backups ───────────────────────────────────────────────────────────────────
# Off-box destination for nightly DB dumps (scripts/backup.sh). Strongly
# recommended — a backup only on this server is lost if the server is.
# Requires the AWS CLI configured on the box with s3:PutObject on the bucket.
BACKUP_S3=
