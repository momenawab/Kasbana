# Generate with: openssl rand -hex 32
# This secret is shared only by the `web` container and the internal collector.
OPS_COLLECTOR_TOKEN=
OPS_SERVER_LOCATION=eu-north-1

# Django-side encryption key for the Telegram bot token. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPS_SETTINGS_ENCRYPTION_KEY=

# The collector is an internal compose service; do not expose it through Caddy.
