# Copy to .env for local development (never commit .env).

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://kasbana.net
DJANGO_TIME_ZONE=Africa/Cairo

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://kasbana.net

# Database — leave unset to use SQLite locally.
# For MySQL on Hostinger:
# DATABASE_ENGINE=django.db.backends.mysql
# DATABASE_NAME=kasbana
# DATABASE_USER=kasbana
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
