# Copy to .env for local development (never commit .env).
# Contract reference: §3.8 Environment variables.

# ── Django ────────────────────────────────────────────────────────────────────
# Select the settings module: config.settings.dev (local) | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://kasbana.net
DJANGO_TIME_ZONE=Africa/Cairo
# Public HTTPS host — builds Apple webServiceURL & Google save URLs.
BASE_URL=http://localhost:8000

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://kasbana.net

# ── Data ──────────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use SQLite locally. Postgres in production:
# DATABASE_URL=postgres://user:pass@host:5432/kasbana
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to REDIS_URL if unset.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Apple Wallet (Phase 1.1) ──────────────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.app.kasbana.loyalty
APPLE_PASS_CERT_PATH=/secrets/pass.p12
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=/secrets/wwdr.pem
APNS_USE_SANDBOX=false

# ── Google Wallet (Phase 1.1) ─────────────────────────────────────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SA_KEY_PATH=/secrets/google-sa.json

# ── Tokens (Phase 1.1) ────────────────────────────────────────────────────────
WALLET_AUTH_TOKEN_SECRET=
PASS_BARCODE_SECRET=

# ── Messaging / Billing (Phase 1.4) ───────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
PAYMOB_API_KEY=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# ── Ops (Phase 5) ─────────────────────────────────────────────────────────────
# Leave SENTRY_DSN blank to disable Sentry (dev/CI). Set it in prod to enable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLE_LOGS=true
SENTRY_SEND_PII=false
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0   # >0 to enable CPU profiling
# SENTRY_RELEASE is set automatically by compose (= deployed image tag).
