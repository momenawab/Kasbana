# Stampn SPA — Apache config for Hostinger
# Served from the `deployment` branch (built output at web root).

# ── Single-Page App routing ──────────────────────────────────────────────────
# Send every request that isn't a real file/dir to index.html so client-side
# routes (/support, /privacy) work on refresh and direct links.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────────
# Hashed assets are immutable; keep index.html always fresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2?|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
