# Real backend base; API client uses VITE_API_URL + "/api/v1".
VITE_API_URL=http://localhost:8000
# "1" = serve all API calls from MSW mocks; "0" = hit the real backend.
VITE_USE_MOCKS=1

# --- Maps (Locations picker) ---
# MapTiler key powers the location map (street/satellite tiles, Arabic/English
# labels, geocoding search). Get a free key at https://cloud.maptiler.com/account/keys/
# Baked into the bundle at build time. Without it the picker shows a notice.
VITE_MAPTILER_KEY=

# --- Sentry (browser error reporting, Phase 3) ---
# All optional: with no DSN the SDK never initialises, so dev + the mock build
# stay silent. Set the DSN at build time (baked into the bundle) to turn it on.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# VITE_SENTRY_ENVIRONMENT=production      # defaults to "production"
# VITE_SENTRY_RELEASE=<git-sha>           # ties issues to a deploy
# VITE_SENTRY_TRACES_RATE=0.1             # perf-trace sample rate (0..1)
