    "i18next": "^23.11.5",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.400.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-i18next": "^14.1.2",
